---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Chat from "../components/chat/Chat";
import { withBase } from "@cloudflare/nimbus-docs/runtime";
---

<BaseLayout title="Chat with your docs" description="Ask your documentation questions with a model running locally in your browser.">
  <Header showSidebar={false} />
  <main id="main-content" tabindex="-1">
    <Chat client:only="react" endpoint={withBase("/mcp", import.meta.env.BASE_URL)}>
      <p slot="fallback" style="padding: 3rem; text-align: center">Loading chat...</p>
    </Chat>
  </main>
</BaseLayout>
